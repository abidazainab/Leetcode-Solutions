Solution in Java:
class Solution {
    public int missingNumber(int[] nums) {
    var n = nums.length;
    var expected_sum = (n*(n+1))/2;
    var sum = 0;
    for (int i = 0; i < n; i++){
        sum += nums[i];
    }

    return expected_sum - sum;
    }
}
###------------------------------------------------------------------------###
Solution in Python:
class Solution(object):
    def missingNumber(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        n = len(nums)
        expected_sum = (n*(n+1))/2;
        sum = 0;
        for i in range(n):
            sum += nums[i];
        
        return expected_sum - sum

